{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "~/.config/kilo/instructions/*.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "pwd *": "allow",
      "echo *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "printenv *": "allow",
      "man *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "*>*": "ask",
      "sed *": "allow",
      "./gradlew *": "allow",
      "find *": "allow",
      "unzip *": "allow",
      "javap *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "paste *": "allow",
      "bc *": "allow",
      "~/Library/Android/sdk/platform-tools/adb *": "allow",
      "sleep *": "allow",
      "system_profiler *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git branch *": "allow",
      "git clone *": "allow",
      "sort *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "true *": "allow",
      "npm ls *": "allow",
      "git switch *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "python3 *": "allow",
      "git checkout *": "allow",
      "rm *": "allow",
      "git show *": "allow",
      "git worktree *": "allow",
      "git remote -v *": "allow",
      "basename *": "allow",
      "git commit *": "ask",
      "git push *": "allow",
      "git config user.name *": "allow",
      "git config user.email *": "allow",
      "adb *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/var/folders/w6/26g5mtqs2vxf3rnhc2hdq22c0000gn/T/kilo/*": "allow",
      "/private/var/folders/w6/26g5mtqs2vxf3rnhc2hdq22c0000gn/T/kilo/*": "allow"
    },
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "ask",
    "codesearch": "allow"
  }
}